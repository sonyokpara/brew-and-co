{
  "$description": "Brew & Co. design tokens (W3C DTCG format). Mirrors tokens.css; edit both together.",
  "color": {
    "$type": "color",
    "roast": {
      "950": { "$value": "#090c12", "$description": "Page background" },
      "900": { "$value": "#0f131c", "$description": "Alternate section" },
      "800": { "$value": "#161c29", "$description": "Inputs, raised neutral surfaces" },
      "700": { "$value": "#222a3a", "$description": "Neutral borders, dividers" },
      "600": { "$value": "#1f2b47", "$description": "Navy glow in the stats band" }
    },
    "espresso": {
      "900": { "$value": "#1c120a" },
      "800": { "$value": "#2a1a0e" },
      "700": { "$value": "#3d2614" },
      "600": { "$value": "#5a3a1f", "$description": "Card border" }
    },
    "crema": {
      "300": { "$value": "#ffc27a" },
      "400": { "$value": "#ffa640", "$description": "Hover" },
      "500": { "$value": "#f5911e", "$description": "Base accent" },
      "600": { "$value": "#d9760a", "$description": "Pressed" },
      "700": { "$value": "#a85a06" }
    },
    "foam": {
      "50": { "$value": "#fbf6ef", "$description": "Primary text" },
      "100": { "$value": "#f1e8dc" }
    },
    "steam": {
      "300": { "$value": "#c2baaf", "$description": "Secondary text" },
      "500": { "$value": "#8c857b", "$description": "Meta text, placeholders" }
    },
    "ink": { "$value": "#1a0f05", "$description": "Text on crema" },
    "paper": { "$value": "#ffffff", "$description": "Product tile frame" },
    "success": { "$value": "#7cc47f" },
    "danger": { "$value": "#f2685c" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Bricolage Grotesque", "ui-sans-serif", "system-ui", "sans-serif"] },
      "script": { "$value": ["Yellowtail", "cursive"], "$description": "Wordmark only" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "extrabold": { "$value": 800 }
    }
  },
  "text": {
    "$type": "typography",
    "micro":      { "$value": { "fontSize": "0.75rem",   "lineHeight": 1.4 } },
    "caption":    { "$value": { "fontSize": "0.875rem",  "lineHeight": 1.5 } },
    "body":       { "$value": { "fontSize": "1rem",      "lineHeight": 1.6 } },
    "lead":       { "$value": { "fontSize": "1.125rem",  "lineHeight": 1.6 } },
    "title-sm":   { "$value": { "fontSize": "1.3125rem", "lineHeight": 1.3 } },
    "title":      { "$value": { "fontSize": "1.5rem",    "lineHeight": 1.25 } },
    "heading":    { "$value": { "fontSize": "1.875rem",  "lineHeight": 1.15, "letterSpacing": "-0.01em" } },
    "heading-lg": { "$value": { "fontSize": "2.25rem",   "lineHeight": 1.1,  "letterSpacing": "-0.015em" } },
    "display":    { "$value": { "fontSize": "3rem",      "lineHeight": 1.05, "letterSpacing": "-0.02em" } },
    "display-lg": { "$value": { "fontSize": "3.75rem",   "lineHeight": 1,    "letterSpacing": "-0.025em" } },
    "hero":       { "$value": { "fontSize": "4.5rem",    "lineHeight": 0.98, "letterSpacing": "-0.03em" } }
  },
  "radius": {
    "$type": "dimension",
    "tag":   { "$value": "0.25rem" },
    "tile":  { "$value": "0.625rem" },
    "card":  { "$value": "1rem" },
    "panel": { "$value": "1.5rem" },
    "pill":  { "$value": "9999px" }
  },
  "space": {
    "$type": "dimension",
    "unit":       { "$value": "0.25rem", "$description": "Tailwind base spacing step" },
    "gutter":     { "$value": "1rem" },
    "section":    { "$value": "6rem" },
    "section-sm": { "$value": "4rem" }
  },
  "size": {
    "$type": "dimension",
    "container-site":  { "$value": "75rem" },
    "container-prose": { "$value": "36rem" },
    "touch-target":    { "$value": "2.75rem", "$description": "44px minimum for primary controls" }
  },
  "shadow": {
    "$type": "shadow",
    "card": { "$value": [
      { "inset": true, "offsetX": "0", "offsetY": "1px", "blur": "0", "spread": "0", "color": "rgb(255 255 255 / 0.05)" },
      { "offsetX": "0", "offsetY": "24px", "blur": "48px", "spread": "-24px", "color": "rgb(0 0 0 / 0.7)" }
    ] },
    "glow": { "$value": [
      { "offsetX": "0", "offsetY": "0", "blur": "0", "spread": "1px", "color": "rgb(245 145 30 / 0.4)" },
      { "offsetX": "0", "offsetY": "16px", "blur": "40px", "spread": "-16px", "color": "rgb(245 145 30 / 0.45)" }
    ] },
    "tile": { "$value": { "offsetX": "0", "offsetY": "18px", "blur": "40px", "spread": "-20px", "color": "rgb(0 0 0 / 0.8)" } }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "150ms" },
      "base": { "$value": "240ms" },
      "slow": { "$value": "600ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "pour":   { "$value": [0.2, 0.7, 0.2, 1], "$description": "Entrances" },
      "settle": { "$value": [0.4, 0, 0.2, 1],   "$description": "State changes" }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm":  { "$value": "40rem" },
    "md":  { "$value": "48rem" },
    "lg":  { "$value": "64rem" },
    "xl":  { "$value": "80rem" }
  }
}
